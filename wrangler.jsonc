{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vikings-technika",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // premenné a secrets nastavené v Cloudflare dashboarde sa pri deployi nezmažú
  "keep_vars": true,
  "observability": { "enabled": true },
  // počty rozborov používateľov (2 zadarmo, s Pro 10 mesačne) – jeden Durable Object na používateľa
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "Quota" }] },
  "migrations": [{ "tag": "v1-quota", "new_sqlite_classes": ["Quota"] }]
}
